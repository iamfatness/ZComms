# Spike A local configuration -- COPY to local.env and fill in.
#
# local.env is gitignored. Nothing in this directory may contain a real
# credential. Credentials are kept out of the command line as well as out of
# the repo, because a command line ends up in shell history.
#
# Plan §3.6: ZComms needs its own Marketplace identity before it ships. Until
# then a spike may borrow an existing approved app's public client id, which
# is a public identifier rather than a secret -- but the meeting details and
# any SDK secret next to it are not, so the whole file stays local.

# --- Auth: use ONE of the two blocks below ---------------------------------

# General app (public client). Preferred: no secret lives on this machine.
public_app_key=

# Meeting SDK key + secret. The harness mints an HS256 JWT locally from these,
# which is acceptable for a spike on one machine and is NOT acceptable in a
# shipped binary -- see the note at the top of src/jwt.h.
#sdk_key=
#sdk_secret=

# --- Meeting ---------------------------------------------------------------
# Accepts a raw id, a spaced id, or a full join URL (the passcode is read out
# of the URL if it carries one). Can also be passed as --meeting.
meeting_number=
meeting_password=

# How the harness appears in the participant list. Worth making obvious: it is
# a second client sitting in a real meeting.
display_name=ZComms Spike A

# Substring of the output device the SECOND Zoom client is playing to.
# Leave blank for the system default. Run --list-devices to see the options.
loopback_device=
